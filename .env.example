# Site
NEXT_PUBLIC_SITE_URL=https://agahorche.pl

# Google Tag Manager (leave unset in dev to avoid polluting production data)
NEXT_PUBLIC_GTM_ID=

# Supabase (backend/database/auth) — see /lib/database/supabase.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Aga Admin (/admin) — see /lib/auth/admin-auth.ts
# Required in every environment: signs the admin session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# "Strefa Klienta" (see /lib/auth/client-auth.ts) — ETAP 7, real client
# accounts, separate from Aga Admin. Required for /strefa-klienta to work
# at all (self-hosted Postgres only, no dev fallback — registration/login
# fail closed with a friendly message until both DATABASE_URL and this are
# set). Generate with: openssl rand -base64 32. NEVER reuse AUTH_SECRET —
# keeping the two secrets distinct means an admin session can never be
# forged from a client token or vice versa.
CLIENT_AUTH_SECRET=

# Self-hosted Postgres login (see /lib/auth/admin-auth.ts) — Zadanie 4,
# Krok 4: replaces Supabase Auth for /admin. Leave ADMIN_AUTH_PROVIDER
# unset in every environment until the Krok 6 cutover; today's behavior
# (Supabase Auth in production, dev-fallback locally) is unaffected either
# way. Set to "local-vps" to make signInAdmin() check admin_users.password_hash
# instead. DATABASE_URL is also used directly by scripts/create-admin-local.mjs.
ADMIN_AUTH_PROVIDER=
DATABASE_URL=

# Dev-only login fallback, used ONLY when Supabase is not configured AND
# NODE_ENV !== "production" (refused outright in production regardless).
# Lets you log into /admin locally without a Supabase project.
ADMIN_DEV_EMAIL=
ADMIN_DEV_PASSWORD=

# n8n — outbound webhooks this app calls (see /lib/n8n/client.ts)
N8N_LEAD_WEBHOOK_URL=
N8N_SEO_WEBHOOK_URL=
N8N_SOCIAL_WEBHOOK_URL=

# n8n — shared secret required on INBOUND requests from n8n to /api/n8n/*
N8N_INBOUND_SECRET=

# Direct lead notification email (see /lib/email/client.ts) — sends over
# plain SMTP using Aga's own existing mailbox (no third-party email API, no
# new account). Both SMTP_USER and SMTP_PASSWORD must be set or the send
# silently no-ops (dev-safe default). SMTP_HOST/SMTP_PORT default to
# interia.pl's server (smtp.interia.pl:465) — override only if the mailbox
# changes. SMTP_PASSWORD should be an app-specific password if the
# provider offers one (interia.pl: Ustawienia → Bezpieczeństwo), not the
# main webmail login password.
SMTP_HOST=smtp.interia.pl
SMTP_PORT=465
SMTP_USER=gunia663@interia.pl
SMTP_PASSWORD=

# AI provider (see /lib/ai/client.ts) — provider-agnostic, not implemented yet
AI_API_KEY=
AI_MODEL=

# Self-hosted media storage (see /lib/admin/media-upload.ts) — Zadanie 4,
# Krok 3: replaces Supabase Storage on the VPS. Leave both unset in every
# environment until the Krok 6 cutover; today's behavior (Supabase Storage
# in production, /public/uploads locally) is unaffected either way.
# MEDIA_STORAGE_PROVIDER=local-vps enables it; MEDIA_STORAGE_DIR overrides
# where files are written/read from (defaults to ./storage/media, which on
# the VPS is a persistent Docker volume mounted at /app/storage/media).
MEDIA_STORAGE_PROVIDER=
MEDIA_STORAGE_DIR=
